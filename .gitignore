# build output
dist/

# generated types
.astro/

# local backups created by `pnpm momo backup`
.backup/

# dependencies
node_modules/
.pnpm-store/

# Time 网站版依赖（独立用 npm 管理，见 script/momo/build-web.js）
web/node_modules/
web/dist/

# ---------------------------------------------------------------
# 口令、密钥与本地状态：绝对不能提交
#
# 这些规则放在仓库根，作用范围是整个仓库。写在 web/.gitignore 里只对
# web/ 生效，script/ 或仓库根目录下的同名文件会漏掉。
# ---------------------------------------------------------------

# 文件名或扩展名里带这些词的，一律不提交
*密钥*
*密码*
*token*
*secret*
*credential*
*api-key*
*apikey*
*passwd*
*password*
.apikey
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.htpasswd
.netrc

# 环境变量文件（保留 .env.example 作为模板）
.env
.env.*
!.env.example

# Cloudflare / Wrangler 的本地状态与本地密钥
.wrangler/
**/.wrangler/
.dev.vars
**/.dev.vars

# ---------------------------------------------------------------
# 例外：这些源码文件名里带 token，但必须提交
# ---------------------------------------------------------------
!web/src/storage/remote-settings.ts
!web/worker/http.mjs
!web/worker/http.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# vscode setting folder
.vscode/

# AI tools
AGENT.md

# local-only service launcher
/manage.cmd
/manage.ps1
