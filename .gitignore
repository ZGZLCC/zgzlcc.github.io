# build output
dist/

# generated types
.astro/

# local backups created by `pnpm momo backup`
.backup/

# dependencies
node_modules/
.pnpm-store/

# ---------------------------------------------------------------
# 口令、密钥与本地状态：绝对不能提交
#
# 这些规则放在仓库根，作用范围是整个仓库；子目录里的同名文件也受它约束。
# ---------------------------------------------------------------

# 文件名或扩展名里带这些词的，一律不提交
*密钥*
*密码*
*token*
*secret*
*credential*
*api-key*
*apikey*
*passwd*
*password*
.apikey
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.htpasswd
.netrc

# 环境变量文件（保留 .env.example 作为模板）
.env
.env.*
!.env.example

# Cloudflare / Wrangler 的本地状态与本地密钥
.wrangler/
**/.wrangler/
.dev.vars
**/.dev.vars

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# vscode setting folder
.vscode/

# AI tools
AGENT.md

# local-only service launcher
/manage.cmd
/manage.ps1
