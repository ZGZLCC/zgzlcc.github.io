---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Search from '@components/misc/Search.astro';
import PagePhotoBackground from '@components/PagePhotoBackground.astro';
import { siteConfig } from '@/config';


interface Props {
  title: string;
  lang: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  section?: string;
  keywords?: string[];
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** 页面是否渲染 Markdown 正文（透传给 Layout，用于异步加载引用块字体） */
  markdownFont?: boolean;
  photoBackground?: 'home' | 'reuse';
}
const {
  title,
  lang,
  description,
  image,
  type,
  publishedTime,
  modifiedTime,
  section,
  keywords,
  noindex,
  structuredData,
  markdownFont,
  photoBackground,
} = Astro.props;

---

<Layout
  title={title}
  lang={lang}
  description={description}
  image={image}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  section={section}
  keywords={keywords}
  noindex={noindex}
  structuredData={structuredData}
  markdownFont={markdownFont}
>
  <div class="relative isolate flex flex-col min-h-screen">
    {photoBackground && (siteConfig.homePhotos.length > 0 || siteConfig.homePhotosMobile.length > 0) &&
      <PagePhotoBackground newPhoto={photoBackground === 'home'} />}
    <div>
      <Header />
    </div>
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <Search />
  </div>
</Layout>
